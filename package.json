{
  "name": "novieri-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack && node scripts/localize-export.mjs",
    "serve": "npx serve out",
    "lint": "eslint",
    "build:hubspot": "node scripts/check-hubspot-theme.mjs && node scripts/build-company-profile.mjs && node scripts/build-functions.mjs && tailwindcss -i hubspot/build/theme.css -o hubspot/src/theme/novieri/css/theme.css --minify",
    "check:hubspot": "node scripts/check-hubspot-theme.mjs"
  },
  "dependencies": {
    "next": "15.5.22",
    "next-intl": "^4.13.4",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.22",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
